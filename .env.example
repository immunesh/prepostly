# Copy to .env and fill in what you need. Everything is optional: without keys, Prepostly uses
# the built-in writer, free Openverse stock photos and the Sandbox channel.

PORT=4100
HOST=127.0.0.1
# Public https URL of this server. Instagram, Threads, Pinterest, TikTok photo posts and
# Google Business download media from it, and OAuth redirects come back to it.
PUBLIC_URL=
# Your business name and support email, shown on /privacy, /terms and /data-deletion.
# Meta, Google, LinkedIn and TikTok app review need these pages and a contact address.
LEGAL_NAME=Prepostly
SUPPORT_EMAIL=
# Encrypts stored social tokens. If empty, a random key is created in data/secret.key.
APP_SECRET=
DATA_DIR=data

# ---- AI copywriting (Claude) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ---- Images ----
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=
# Without any stock key, photos come from Openverse (free, no key, CC-licensed for commercial use).
# Set to off to keep stock photos disabled.
OPENVERSE=on
# AI-generated images. Cloudflare Workers AI runs the open-source FLUX.1 [schnell] model, free
# within its daily allocation (token with the Workers AI permission); OpenAI Images is the other option.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# With both set, which one to try first (cloudflare or openai); the other is the fallback.
IMAGE_PROVIDER=cloudflare
# UGC avatar videos
HEYGEN_API_KEY=
# Optional: presenter and voice (list yours with `npm run heygen`). Empty = first avatar, voice in the post's language.
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# On-device voiceover (Kokoro). Set to off to skip the ~90 MB model download.
VOICEOVER=on

# ---- Social platforms (OAuth apps). Redirect URI: {PUBLIC_URL}/oauth/callback/{platform} ----
# Facebook Pages + Instagram (one Meta app). In the app dashboard also set:
#   Data deletion callback: {PUBLIC_URL}/callbacks/meta/data-deletion
#   Deauthorize callback:   {PUBLIC_URL}/callbacks/meta/deauthorize
META_APP_ID=
META_APP_SECRET=
# Threads. Also set Uninstall callback {PUBLIC_URL}/callbacks/threads/uninstall
# and Delete callback {PUBLIC_URL}/callbacks/threads/data-deletion
THREADS_APP_ID=
THREADS_APP_SECRET=
# LinkedIn personal profiles (products: Sign In with LinkedIn using OpenID Connect + Share on LinkedIn)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LinkedIn company Pages (product: Community Management API). Can be the same app as above.
LINKEDIN_PAGES_CLIENT_ID=
LINKEDIN_PAGES_CLIENT_SECRET=
# X (OAuth 2.0 with PKCE)
X_CLIENT_ID=
X_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# YouTube, Google Business Profile and Blogger (one Google OAuth client; enable each API)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Tumblr (tumblr.com/oauth/apps; OAuth2 redirect URL {PUBLIC_URL}/oauth/callback/tumblr)
TUMBLR_CLIENT_ID=
TUMBLR_CLIENT_SECRET=
# Bluesky, Mastodon, Telegram, Discord and Slack connect with tokens or webhooks in the app; no server setup needed.

# Billing with Dodo Payments. Without it, only site admins can assign plans.
# Webhook URL to register in Dodo: {PUBLIC_URL}/api/billing/webhook/dodo
# (events: payment.*, subscription.*, refund.*). DODO_PAYMENTS_ENV is test or live.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PAYMENTS_ENV=test
DODO_PRODUCT_CORE=
DODO_PRODUCT_RISE=
DODO_PRODUCT_ENTERPRISE=

# Admin dashboard (/app/admin): comma-separated emails of site admins.
ADMIN_EMAILS=
# Prices used for the admin cost reports. HeyGen bills per minute of avatar video;
# set OPENAI_IMAGE_USD / CLOUDFLARE_IMAGE_USD for a flat price per AI image (empty uses list prices).
HEYGEN_USD_PER_MINUTE=1
OPENAI_IMAGE_USD=
CLOUDFLARE_IMAGE_USD=
